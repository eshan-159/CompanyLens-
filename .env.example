# =============================================================================
# CompanyLens - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Get FREE Groq API key at: https://console.groq.com/keys
# =============================================================================

# -----------------------------------------------------------------------------
# AI/LLM Configuration (REQUIRED)
# -----------------------------------------------------------------------------

# Groq API Key (FREE - Recommended)
# Get your free API key at: https://console.groq.com/keys
# Groq provides ultra-fast inference with Llama 3.1 - 100x faster than local LLMs
GROQ_API_KEY=your_groq_api_key_here

# Alternative: OpenAI API Key (OPTIONAL - if you prefer OpenAI)
# Only needed if you want to use OpenAI instead of Groq
# LLM_API_KEY=sk-your_openai_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here

# LLM Model Selection
# For Groq (default): llama-3.1-8b-instant
# For OpenAI: gpt-4o-mini, gpt-4, gpt-3.5-turbo
LLM_MODEL=llama-3.1-8b-instant

# LLM Base URL (change only if using custom endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# Search API Configuration (OPTIONAL)
# -----------------------------------------------------------------------------

# Apify API Token (OPTIONAL - for advanced web crawling)
# DuckDuckGo is used by default (no API key needed)
# Get Apify token at: https://console.apify.com/account/integrations
# APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------------------

# Batch Processing
BATCH_SIZE=30                    # Number of companies to process per batch
MAX_RETRIES=3                    # Number of retry attempts on failure
RETRY_DELAY=2.0                  # Delay between retries (seconds)

# Web Crawling Settings
CRAWL_DEPTH=1                    # Maximum depth for website crawling (1 = homepage + about)
MAX_PAGES_PER_DOMAIN=1           # Maximum pages to crawl per website
PAGE_TIMEOUT_SECS=20             # Timeout for page loads (seconds)

# Search Settings
SEARCH_RESULTS_LIMIT=5           # Maximum search results to consider per company

# Rate Limiting
REQUEST_DELAY=1.0                # Delay between requests (seconds) - be respectful!

# -----------------------------------------------------------------------------
# Python Environment (Auto-detected - usually no need to change)
# -----------------------------------------------------------------------------

# Python executable path (override if needed)
# PYTHON_PATH=/path/to/your/python

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=company_scraper.log

# -----------------------------------------------------------------------------
# Notes:
# -----------------------------------------------------------------------------
# 1. Never commit the .env file to version control
# 2. Groq API is FREE and much faster than alternatives
# 3. Start with default settings and adjust based on your needs
# 4. Lower BATCH_SIZE if you hit rate limits
# 5. Increase PAGE_TIMEOUT_SECS if dealing with slow websites
# =============================================================================
